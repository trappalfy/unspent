# ---- Site (apps/web) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_HOST=localhost:8787
NEXT_PUBLIC_X_URL=https://x.com/
# true = "Launching soon" mode: /app closed, Docs open (brief 11.6)
NEXT_PUBLIC_PRELAUNCH=false
# Project token CA for the footer; leave empty to hide the line (brief 11.6)
NEXT_PUBLIC_PROJECT_TOKEN_CA=
# localnet | devnet | mainnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# 32+ random bytes, base64; signs SIWS nonces and session cookies
SESSION_SECRET=

# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unspent
REDIS_URL=

# ---- Gateway (services/gateway) ----
GATEWAY_PORT=8787
# mock = recorded SSE streams, no paid calls (brief rule 0.3); live = real provider
PROVIDER_MODE=mock
# comma-separated; several keys spread rate limits
ANTHROPIC_API_KEYS=
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
MARKUP_BPS=1500
RPC_URL=https://api.devnet.solana.com
RPC_WS_URL=wss://api.devnet.solana.com
# path to the gateway hot key (JSON keypair), never committed
GATEWAY_KEYPAIR_PATH=
JUPITER_API_KEY=
# mock provider URL in development; https://api.anthropic.com with PROVIDER_MODE=live
ANTHROPIC_BASE_URL=http://127.0.0.1:8788
# where alerts (disabled provider key, stuck settlements, reserve mismatch) are POSTed
ALERT_WEBHOOK_URL=
MAX_PRIORITY_FEE_MICROLAMPORTS=200000
