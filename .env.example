# ---- Site (apps/web) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_HOST=localhost:8787
NEXT_PUBLIC_X_URL=https://x.com/
# true = "Launching soon" mode: /app closed, Docs open (brief 11.6)
NEXT_PUBLIC_PRELAUNCH=false
# Project token CA for the footer; leave empty to hide the line (brief 11.6)
NEXT_PUBLIC_PROJECT_TOKEN_CA=
# mainnet | localnet (local Surfpool fork: ops/surfpool-up.sh)
NEXT_PUBLIC_SOLANA_NETWORK=mainnet
# 32+ random bytes, base64; signs SIWS nonces and session cookies
SESSION_SECRET=

# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/unspent
REDIS_URL=

# ---- Gateway (services/gateway) ----
GATEWAY_PORT=8787
# mock = recorded SSE streams, no paid calls (brief rule 0.3); live = real provider
PROVIDER_MODE=mock
# comma-separated; several keys spread rate limits
ANTHROPIC_API_KEYS=
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
MARKUP_BPS=1500
# Server-side only (web /api/rpc relay, gateway, indexer); the key never reaches the browser
RPC_URL=https://mainnet.helius-rpc.com/?api-key=
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=
# the gateway hot key: a path to its JSON keypair file, or GATEWAY_KEYPAIR with the JSON itself (Fly secret)
GATEWAY_KEYPAIR_PATH=
GATEWAY_KEYPAIR=
# Jupiter Swap API v2 /build + Tokens API, called only by the web server (/api/jupiter/*)
JUPITER_API_KEY=
# mock provider URL in development; https://api.anthropic.com with PROVIDER_MODE=live
ANTHROPIC_BASE_URL=http://127.0.0.1:8788
# where alerts (disabled provider key, stuck settlements, reserve mismatch) are POSTed
ALERT_WEBHOOK_URL=
MAX_PRIORITY_FEE_MICROLAMPORTS=200000

# ---- Credit token (ops/launch.ts + /token.json) ----
# Symbol of the credit token (Q1); the same value goes to launch.ts and the site's /token.json
TOKEN_SYMBOL=

# ---- Legal pages (/terms, /privacy) ----
# Shown in the Terms and Privacy drafts; a production build of the open site fails without them
LEGAL_ENTITY=
CONTACT_EMAIL=
GOVERNING_LAW=

# ---- Gateway regional check (Q13) ----
# DB-IP country database; the Docker image sets it. Empty = check off (local development)
GEOIP_DB_PATH=
